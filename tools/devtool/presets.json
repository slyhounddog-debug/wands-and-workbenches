{
  "_about": "Screens the dev tool's preview can load. Read on every request (no restart). fixture = an entry of fixtures (a save seeded into slot 1 of the preview's own storage, never your real saves); hold = stay on the loading screen; freeze (default true) = stop game time once the steps are done. steps run in the preview after boot: {waitFor: selector, timeout?}, {click: selector}, {key: 'KeyT'} (a game hotkey, by e.code), {show: selector} / {hide: selector} (remove / add the hidden class), {wait: ms}, {include: 'presetId'}, {eval: 'js'} (W = window.__wands, G = the game state, UI), {freeze: true|false}. The order here is the dropdown order.",
  "fixtures": [
    { "id": "midgame", "label": "Mid-game factory (goal 14, 10 unlocks)", "file": "tools/devtool/fixtures/midgame.json" }
  ],
  "presets": [
    { "id": "loading", "label": "Loading screen", "hold": true, "steps": [ { "waitFor": "#loadMsg.ready" } ] },
    { "id": "menu", "label": "Title menu", "fixture": "midgame", "steps": [ { "waitFor": "#menuMain" } ] },
    { "id": "menu-fresh", "label": "Title menu (no save yet)", "steps": [ { "waitFor": "#menuMain" } ] },
    { "id": "menu-new", "label": "Title > New Game (slots)", "fixture": "midgame", "steps": [ { "waitFor": "#mNew" }, { "click": "#mNew" }, { "waitFor": "#menuSlots" } ] },
    { "id": "menu-load", "label": "Title > Load Game (slots)", "fixture": "midgame", "steps": [ { "waitFor": "#mLoad" }, { "click": "#mLoad" }, { "waitFor": "#menuSlots" } ] },
    { "id": "how", "label": "Title > How to Play (The Idea)", "steps": [ { "waitFor": "#mHow" }, { "click": "#mHow" }, { "waitFor": "#menuHow" } ] },
    { "id": "how-factory", "label": "Title > How to Play > Factory", "steps": [ { "include": "how" }, { "click": "#menuHow .tab[data-t='FACTORY']" } ] },
    { "id": "how-recipes", "label": "Title > How to Play > Recipes", "steps": [ { "include": "how" }, { "click": "#menuHow .tab[data-t='RECIPES']" } ] },
    { "id": "how-wilds", "label": "Title > How to Play > Wilds", "steps": [ { "include": "how" }, { "click": "#menuHow .tab[data-t='WILDS']" } ] },
    { "id": "how-controls", "label": "Title > How to Play > Controls", "steps": [ { "include": "how" }, { "click": "#menuHow .tab[data-t='CONTROLS']" } ] },
    { "id": "settings", "label": "Title > Settings", "steps": [ { "waitFor": "#mSet" }, { "click": "#mSet" }, { "waitFor": "#menuSet" } ] },
    { "id": "hud", "label": "In game: HUD (mid-game save)", "fixture": "midgame", "steps": [ { "waitFor": "#mContinue" }, { "click": "#mContinue" }, { "waitFor": "#hotbar" }, { "wait": 900 } ] },
    { "id": "hud-new", "label": "In game: new game + controls card", "steps": [ { "waitFor": "#mNew" }, { "click": "#mNew" }, { "waitFor": "#menuSlots" }, { "click": "#menuSlots button.slot" }, { "waitFor": "#help" }, { "wait": 900 } ] },
    { "id": "help", "label": "In game: controls card (H)", "steps": [ { "include": "hud" }, { "click": "#btnHelp" }, { "waitFor": "#help" } ] },
    { "id": "hotbar-tip", "label": "In game: hotbar tooltip + inspector", "steps": [ { "include": "hud" }, { "freeze": true }, { "eval": "UI.showTip('forge'); UI.tipT = 1e9; UI.setInspect('ELEMENTAL FORGE: making Flamethrower. STARVED: needs Fire Ember')" } ] },
    { "id": "toasts", "label": "In game: toasts (both sides)", "steps": [ { "include": "hud" }, { "freeze": true }, { "eval": "UI.toast('Goal complete! +15 XP', 'L', 'ic_target'); UI.toast('Unlocked: Swift Harnessing 3', 'L', 'ic_fast'); UI.toast('An Ember Imp! Weak to Water', 'R', 'ic_skull'); UI.toast('Goal complete! +15 XP', 'R', 'ic_target')" } ] },
    { "id": "tree-l", "label": "In game: Skill Tree (Builder side)", "steps": [ { "include": "hud" }, { "key": "KeyT" }, { "waitFor": "#treeL" } ] },
    { "id": "tree-r", "label": "In game: Skill Tree (Wizard side)", "steps": [ { "include": "hud" }, { "key": "KeyY" }, { "waitFor": "#treeR" } ] },
    { "id": "tree-tip", "label": "In game: Skill Tree hover card", "steps": [ { "include": "tree-l" }, { "eval": "UI.showNodeTip('L', 'swift')" }, { "waitFor": "#nodeTip" } ] },
    { "id": "pause", "label": "In game: pause menu", "steps": [ { "include": "hud" }, { "key": "Escape" }, { "waitFor": "#pauseMain" } ] },
    { "id": "pause-settings", "label": "In game: pause > Settings", "steps": [ { "include": "pause" }, { "click": "#pSet" }, { "waitFor": "#pauseSet" } ] },
    { "id": "debug", "label": "In game: debug overlay (F3)", "steps": [ { "include": "hud" }, { "key": "F3" }, { "wait": 2600 } ] },
    { "id": "swap", "label": "In game: swap meter", "steps": [ { "include": "hud" }, { "freeze": true }, { "eval": "UI.swapRing(0.6)" } ] },
    { "id": "boss", "label": "In game: boss bar (Primal Chimera)", "steps": [ { "include": "hud" }, { "eval": "W.boss()" }, { "waitFor": "#bossBar" }, { "wait": 400 } ] },
    { "id": "results", "label": "In game: expedition results (death)", "steps": [ { "include": "hud" }, { "freeze": true }, { "eval": "UI.showResults()" }, { "waitFor": "#results" } ] },
    { "id": "victory", "label": "In game: victory screen", "steps": [ { "include": "hud" }, { "eval": "UI.showVictory()" }, { "waitFor": "#victory" } ] }
  ]
}
